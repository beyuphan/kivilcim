# Copy to .env and fill in. .env is never committed. Every line below is optional except the
# FIRMS key, and each shows its default.

# --- Data ---------------------------------------------------------------------------------
# NASA FIRMS MAP_KEY (free): https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Without it the site still runs on whatever is stored, but fetches nothing new.
FIRMS_MAP_KEY=

# SQLAlchemy database URL. SQLite is used by the code as written.
DATABASE_URL=sqlite:///kivilcim.db

# FIRMS products to fetch, comma separated.
# FIRMS_SOURCES=VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT,MODIS_NRT
# Days each fetch asks for (FIRMS allows at most 5). After downtime the window widens by itself.
# FIRMS_DAY_RANGE=2
# Minutes between automatic fetches when running `python -m kivilcim`. 0 turns them off.
# INGEST_INTERVAL_MINUTES=30

# --- Weather (Open-Meteo, free for non-commercial use only) ------------------------------------
# Calls per day the server allows itself; at the limit it serves cached weather only.
# OPEN_METEO_DAILY_QUOTA=7000
# Minutes a weather reading is reused, per ~11 km cell.
# WEATHER_CACHE_MINUTES=45

# --- The server ----------------------------------------------------------------------------------
# Requests per minute per client. The weather one is stricter because those requests can make the
# server call Open-Meteo. 0 turns a limit off.
# RATE_LIMIT_PER_MINUTE=120
# RATE_LIMIT_WEATHER_PER_MINUTE=30
# Behind a reverse proxy that you control and that sets X-Forwarded-For, turn this on so each
# visitor gets their own limit. Leave it off otherwise.
# TRUST_PROXY=false
# Which sites may call the read-only API from a browser: * for any, or a comma separated list.
# CORS_ORIGINS=*

# --- The map -------------------------------------------------------------------------------------
# OpenStreetMap's public tile servers are meant for light use. For a busy public site use a tile
# provider and set its URL template and the attribution text it requires.
# TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# TILE_ATTRIBUTION=© OpenStreetMap

# The public address of the site (previews, the sitemap and canonical addresses use it)
# PUBLIC_URL=https://kivilcim.example
